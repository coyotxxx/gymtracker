  "tips": {
    "diabetic": [
      "Kontroluj porcje węglowodanów — stałe, niewielkie porcje w posiłkach",
      "Zamień biały ryż na brązowy lub kaszę gryczaną/jaglaną",
      "Używaj słodzików (erytrytol/stewia/ksylitol) zamiast cukru",
      "Regularność posiłków co 3-4h dla stabilnego cukru",
      "Łącz węglowodany z białkiem i tłuszczem (spowalnia wchłanianie)",
      "Wybieraj produkty o niskim IG (<55)"
    ],
    "insulin_resistance": [
      "Zamień mąkę pszenną na pełnoziarnistą lub orkiszową",
      "Dodawaj orzechy/migdały do posiłków (zdrowe tłuszcze stabilizują cukier)",
      "Warzywa niskoskrobiowe w każdym posiłku (brokuły, szpinak, cukinia, kalafior)",
      "Wymień białe pieczywo na pełnoziarniste lub żytnie",
      "Unikaj produktów o wysokim IG — kasze (gryczana/pęczak) zamiast ziemniaków",
      "Zdrowe tłuszcze — oliwa, awokado, łosoś, makrela",
      "Białko o niskim IG — mięso, jaja, ryby, tofu, soczewica, ciecierzyca"
    ],
    "gluten_free": [
      "Unikaj pszenicy, żyta, jęczmienia + produktów z nich",
      "Sprawdź sosy, panierki, mieszanki przypraw (ukryty gluten)",
      "Naturalnie bezglutenowe: warzywa, owoce, mięso, ryby, jaja, orzechy, nabiał",
      "Bezpieczne kasze: jaglana, quinoa, ryż, gryka",
      "Zamiana mąki pszennej: migdałowa, kokosowa, ryżowa, owsiana certyfikowana, tapioka, kukurydza",
      "Szukaj certyfikatu (przekreślony kłos)"
    ],
    "balance": [
      "Białko stałe w każdym posiłku — chroni masę mięśniową, sycy",
      "Talerz: 1/2 warzywa, 1/4 białko, 1/4 węgle złożone, +zdrowy tłuszcz",
      "Pij wodę 30 ml × kg masy ciała + 500 ml na trening",
      "Unikaj wysoko przetworzonej żywności",
      "Spożywaj dużo błonnika (warzywa, pełnoziarniste) — sycy + obniża IG posiłku"
    ]
  }
